{
  "unit": 14,
  "slug": "shopping-fun",
  "title": "Shopping Fun",
  "world": "toy shop / supermarket",
  "communicative_goal": "Shop with simple prices, wants, and polite requests.",
  "recycled_language": [
    "I want",
    "please",
    "thank you",
    "I like"
  ],
