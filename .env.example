# Local dev only (used by server.js via dotenv).
# On Vercel, set these in Project Settings -> Environment Variables instead —
# this file is never uploaded there.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated fallbacks (max 1 used) when the primary is capacity-throttled:
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Story-page illustrations (preview hydrate → bake into .edb). Opt-in:
# STORY_ART=1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# STORY_ART_TIMEOUT_MS=45000
