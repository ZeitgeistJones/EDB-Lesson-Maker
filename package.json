{
  "name": "classin-lesson-builder",
  "version": "2.0.0",
  "description": "Generates slide-style ESL lesson PDFs for use in ClassIn.",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:bg-picks": "node scripts/smoke-bg-picks.mjs",
    "test:board-bg": "node scripts/verify-board-visual.cjs",
    "test:board-ready": "node scripts/test-board-readiness.mjs",
    "test:vocab-art": "node scripts/test-vocab-art.mjs",
    "test:readiness-vocab": "node scripts/test-readiness-vocab-art.mjs",
    "test:readiness-loop": "node scripts/readiness-loop.mjs",
    "preflight": "node scripts/preflight-boards.cjs",
    "quality": "node scripts/preflight-boards.cjs",
    "quality:full": "node scripts/preflight-boards.cjs --tier=all",
    "fullquality": "node scripts/preflight-boards.cjs --tier=all",
    "quality:status": "node scripts/quality-loop-status.cjs",
    "quality:judge": "node scripts/quality-verdict.cjs",
    "quality:baseline": "node scripts/quality-baseline.cjs",
    "quality:progress": "node scripts/quality-progress.cjs",
    "quality:matrix": "node scripts/page-matrix.cjs",
    "assets:icons": "node scripts/fetch-vocab-icons.mjs",
    "assets:vocab-sheet": "node scripts/import-vocab-sheet.mjs",
    "assets:bg": "node scripts/import-background.mjs",
    "assets:ground-qa": "node scripts/qa-scene-ground.mjs",
    "assets:prop": "node scripts/import-prop.mjs",
    "assets:import-sheet": "node scripts/import-sheet.mjs",
    "assets:merge-staged": "node scripts/merge-staged-props.mjs",
    "assets:prop-blobs": "node scripts/slice-blob-sheet.mjs",
    "assets:prop-blobs-import": "node scripts/import-blob-props.mjs",
    "assets:prop-qa": "node scripts/qa-props.mjs",
    "assets:prop-demand": "node scripts/prop-demand.mjs",
    "coverageloop": "node scripts/asset-coverage-loop.mjs",
    "assets:coverage": "npm run coverageloop",
    "test:asset-coverage": "npm run coverageloop",
    "coverageloop:merge": "node scripts/merge-asset-coverage.mjs",
    "assets:kenney-curate": "node scripts/kenney-curate.mjs",
    "assets:coloring": "node scripts/import-coloring-sheet.mjs",
    "test:coloring": "node scripts/smoke-coloring-outlines.mjs",
    "test:story-art-latency": "node scripts/smoke-story-art-latency.mjs",
    "test:story-art": "node scripts/smoke-story-art-module.cjs",
    "story-art:illustrate": "node scripts/illustrate-fixture-story.mjs",
    "test:phonics": "node scripts/smoke-phonics-policy.cjs && node scripts/test-phonics-audit.cjs",
    "manus:review": "node scripts/manus/review.mjs",
    "manus:dry": "node scripts/manus/review.mjs --dry-run",
    "manus:passoff": "node scripts/manus/write-passoff.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
