{
  "name": "classin-lesson-builder",
  "version": "2.0.0",
  "description": "Generates slide-style ESL lesson PDFs for use in ClassIn.",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:bg-picks": "node scripts/smoke-bg-picks.mjs",
    "test:board-bg": "node scripts/verify-board-visual.cjs",
    "preflight": "node scripts/preflight-boards.cjs",
    "quality": "node scripts/preflight-boards.cjs",
    "quality:full": "node scripts/preflight-boards.cjs --tier=all",
    "quality:status": "node scripts/quality-loop-status.cjs",
    "quality:judge": "node scripts/quality-verdict.cjs",
    "quality:baseline": "node scripts/quality-baseline.cjs",
    "quality:matrix": "node scripts/page-matrix.cjs",
    "assets:icons": "node scripts/fetch-vocab-icons.mjs",
    "assets:vocab-sheet": "node scripts/import-vocab-sheet.mjs",
    "assets:bg": "node scripts/import-background.mjs",
    "assets:ground-qa": "node scripts/qa-scene-ground.mjs",
    "assets:prop": "node scripts/import-prop.mjs",
    "assets:prop-qa": "node scripts/qa-props.mjs",
    "assets:prop-demand": "node scripts/prop-demand.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
