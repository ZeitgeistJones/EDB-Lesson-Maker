{
  "convention": "common-sound-first",
  "locked_at": "2026-08-18",
  "note": "Pre-A1 ESL synthetic phonics. One picture = the letter's most common SOUND, not the letter name. Same mnemonic object for uppercase and lowercase. Letterform must stay a clear letter; the object is a cue, not a letter-shaped illustration.",
  "rules": [
    "Short vowels only: A /æ/, E /ɛ/, I /ɪ/, O /ɒ/, U /ʌ/.",
    "C is hard /k/ (cat), never city /s/.",
    "G is hard /g/ (goat), never giraffe /dʒ/.",
    "X is /ks/ as in fox (final cluster), not x-ray letter-name /ɛks/.",
    "Y is consonant /j/ as in yo-yo, not fly /aɪ/ or happy /i/.",
    "Q is /kw/ as in queen (qu).",
    "S is /s/ (snake), not /z/ or /ʃ/."
  ],
  "letters": {
    "a": {
      "upper": "A",
      "sound": "/æ/",
      "sound_label": "short a",
      "mnemonic": "apple",
      "slug": "apple",
      "avoid": "acorn, apron, alien (long a / letter name)"
    },
